# Postgres connection string
# Local (docker-compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instant_mechanic

# Production (AWS RDS or Postgres on EC2), example:
# DATABASE_URL=postgresql://user:password@your-db-host:5432/instant_mechanic

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Seconds between simulated live status changes (0 disables the simulator)
LIVE_SIMULATOR_INTERVAL=6
